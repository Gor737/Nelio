# Copy to .env (never commit .env). Docker Compose reads the POSTGRES_* values.
POSTGRES_USER=nelio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nelio

# --- Backend (apps/backend) ---
# `npm start`, `npm run start:dev` and `npm run start:debug` load this file automatically (path ../../.env from apps/backend).
# Values already set in the real environment take precedence. `start:prod` loads no file: set real environment variables.
# Required. At least 32 random bytes; generate one with:  openssl rand -base64 48
# The application refuses to start without it, and refuses obvious placeholders.
JWT_SECRET=

# Optional outside production (composed from POSTGRES_* and the Compose port 5433 when absent). Required in production.
# DATABASE_URL=postgresql://nelio:change_me@localhost:5433/nelio

# Origin of the frontend for CORS (exact origin, no path, never *). Defaults to http://localhost:3001 outside production; required in production.
# FRONTEND_ORIGIN=http://localhost:3001

# PORT=3000
# Number of reverse proxies in front of the backend (0-10). 0 = none: X-Forwarded-For is ignored. Set it correctly in production, or the rate limiter sees the proxy's IP.
# TRUST_PROXY=0
# debug | info | warn | error
# LOG_LEVEL=info
# Swagger UI at /api/docs and /api/docs-json. Defaults to true outside production and false in production.
# SWAGGER_ENABLED=true

# --- Mail (apps/backend, Mailpit in development) ---
# `docker compose up` starts Mailpit: SMTP on 1025, the inbox at http://localhost:8025. The defaults below talk to it, so nothing
# needs to be set in development. (The numeric address is the default because resolving the name "localhost" stalls the first
# SMTP connection by about 5 seconds on some machines.)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# true = implicit TLS (port 465). Otherwise STARTTLS is used when the server offers it, and is required in production.
# SMTP_SECURE=false
# Both or neither. The password is never logged.
# SMTP_USER=
# SMTP_PASSWORD=
# Sender of every email: no-reply@example.com or "Nelio <no-reply@example.com>". Required in production, with SMTP_HOST.
# MAIL_FROM=Nelio <no-reply@nelio.local>
