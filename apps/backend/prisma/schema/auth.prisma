// Auth module: RefreshToken, AuthIdentity, EmailToken. Schema group G1.
// Delete behavior (section 8): credentials are owned data, so CASCADE from User.
// Hand-written SQL in the G1 migration: CHECK refresh_tokens_family_age (expires_at <= family_started_at + 90 days).

enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("email_token_type")
}

model RefreshToken {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  familyId        String    @map("family_id") @db.Uuid
  familyStartedAt DateTime  @map("family_started_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuthIdentity {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  providerEmail     String?      @map("provider_email")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime?    @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model EmailToken {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}
