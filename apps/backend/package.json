{
  "name": "backend",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "seed:admin": "node --env-file-if-exists=../../.env dist/seed-first-admin.js",
    "openapi:export": "nest build && node dist/openapi-export.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "node --env-file-if-exists=../../.env --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-integration.json --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:forward-ref": "node scripts/check-forward-ref.mjs src",
    "check:architecture": "npm run check:deps && npm run check:forward-ref",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:prepare": "node --env-file-if-exists=../../.env scripts/db-prepare.mjs",
    "db:migrate:create": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev --create-only",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:drift": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --script --exit-code",
    "db:drift:live": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate diff --from-config-datasource --to-schema prisma/schema --script --exit-code"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/websockets": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "18.7.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "8.23.1",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
